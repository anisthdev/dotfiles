[Unit]
Description=handoff phone link (~/Projects/handoff)
PartOf=graphical-session.target
After=graphical-session.target
# Off by default; toggle-handoff (Quick Actions) starts and stops it

[Service]
ExecStart=%h/.local/share/go/bin/handoffd
# Reloads ~/.config/handoff/config.toml (mute list)
ExecReload=/bin/kill -HUP $MAINPID
# Remove the tray icon however the daemon stops, crashes included
ExecStopPost=-/usr/bin/tray hide --id phone
ExecStopPost=-/bin/sh -c 'rm -f "$XDG_RUNTIME_DIR/handoff/live.json"; pkill -RTMIN+10 -x waybar'
Restart=on-failure
RestartSec=3
