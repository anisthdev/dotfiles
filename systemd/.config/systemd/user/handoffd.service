[Unit]
Description=handoff phone link (~/Projects/handoff)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/share/go/bin/handoffd
# Reloads ~/.config/handoff/config.toml (mute list)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
