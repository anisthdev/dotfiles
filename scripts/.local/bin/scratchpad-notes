#!/usr/bin/env bash

client_exists() {
    hyprctl -j clients | jq -e --arg t "$1" 'any(.[]; .initialClass == $t)' > /dev/null 2>&1
}

is_special_open() {
    hyprctl -j monitors | jq -e --arg ws "special:$1" 'any(.[]; .specialWorkspace.name == $ws)' > /dev/null 2>&1
}

reposition() {
    sleep 0.1
    hyprctl dispatch focuswindow "class:^($1)$"
    hyprctl dispatch movewindow l
    hyprctl dispatch movewindow d
    hyprctl dispatch moveactive 10 -10
}

TITLE="scratchpad-notes"
WS="notes"

if is_special_open "$WS"; then
    hyprctl dispatch togglespecialworkspace "$WS"
else
    if ! client_exists "$TITLE"; then
        uwsm app -- foot --app-id="$TITLE" --title="$TITLE" -e nvim "$HOME/notes/scratchpad.md" &
        until client_exists "$TITLE"; do sleep 0.1; done
    fi
    hyprctl dispatch togglespecialworkspace "$WS"
    reposition "$TITLE"
fi
