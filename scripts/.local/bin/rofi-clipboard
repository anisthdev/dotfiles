#!/usr/bin/env bash
# Clipboard history using wl-paste

history=$(wl-paste --list-history 2>/dev/null | head -20)

if [[ -z "$history" ]]; then
    notify-send "Clipboard" "No history available"
    exit 1
fi

choice=$(echo "$history" | rofi -dmenu -i -p "Clipboard" -theme ~/.config/rofi/app-launcher-theme.rasi)

if [[ -n "$choice" ]]; then
    echo -n "$choice" | wl-paste
    notify-send "Clipboard" "Copied to clipboard" -i org.kde.plasma.clipboard
fi