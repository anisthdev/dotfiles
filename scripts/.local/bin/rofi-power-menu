#!/bin/bash

show_power_menu() {
  # The first characters are invisible sort keys.
  local menu_options="\u200B Lock
\u200C󰤄 Suspend
\u200D Relaunch
\u2060󰜉 Restart
\u2063󰐥 Shutdown"
  local selection=$(echo -e "$menu_options" | rofi -dmenu -font 'SF Mono 16' -u 4 -theme-str 'window listview {lines: 5;} inputbar { enabled: false;} element.urgent { background-color: #93000a80; text-color: #ffb4ab; } element.urgent.selected { background-color: #93000a; text-color: #ffb4ab; }')

  case "$selection" in
  *Lock*) hyprlock ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) uwsm stop ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  esac
}

show_power_menu
