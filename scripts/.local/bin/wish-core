
# --- Configuration ---
for cmd in aws ssh pgrep pkill; do
    if ! command -v $cmd &> /dev/null; then
        echo "Error: Required command '$cmd' not found in PATH."
        exit 1
    fi
done

# --- Argument Parsing ---
if [[ $# -lt 3 ]]; then
    echo "Usage: $0 <INSTANCE_ID> <LOCAL_PORT> <SSH_USER> [--profile <aws-profile>] [--region <aws-region>]"
    exit 1
fi

INSTANCE_ID="$1"
LOCAL_PORT="$2"
SSH_USER="$3"
shift 3

AWS_PROFILE=""
AWS_REGION=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile)
            AWS_PROFILE="$2"
            shift 2
            ;;
        --region)
            AWS_REGION="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# --- State Management ---
PID_FILE="/tmp/ssm_forward_${LOCAL_PORT}.pid"
LOG_PIPE="/tmp/ssm_forward_${LOCAL_PORT}.pipe"

# Define the full ssh command. This is used to accurately count running sessions.
SSH_CMD="ssh $SSH_USER@localhost -p $LOCAL_PORT"
FD_OPENED=false

# --- Pre-run Sanity Check ---
if [ -f "$PID_FILE" ] && ! kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
    echo "🟡 Stale PID file found. Verifying port status before cleanup..."
    if ! lsof -t -i :"$LOCAL_PORT" >/dev/null 2>&1; then
        echo "🧹 Port $LOCAL_PORT is free. Cleaning up stale state files from a previous crash."
        rm -f "$PID_FILE" "$LOG_PIPE"
    else
        echo "⚠️ Stale PID file found, but port $LOCAL_PORT is still in use by another process."
        echo "Please investigate manually. You may need to run 'lsof -i :$LOCAL_PORT' to identify the process."
        exit 1
    fi
fi

# --- Main Logic ---
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
    echo "✅ Port forwarding is already active (PID: $(cat "$PID_FILE"))."
else
    rm -f "$LOG_PIPE"
    mkfifo "$LOG_PIPE"

    aws_args=(
        --target "$INSTANCE_ID"
        --document-name AWS-StartPortForwardingSession
        --parameters "portNumber=22,localPortNumber=$LOCAL_PORT"
    )
    [[ -n "$AWS_PROFILE" ]] && aws_args+=(--profile "$AWS_PROFILE")
    [[ -n "$AWS_REGION" ]] && aws_args+=(--region "$AWS_REGION")

    # Start the AWS SSM command in the background, redirecting its output to our pipe.
    aws ssm start-session "${aws_args[@]}" > "$LOG_PIPE" 2>&1 &
    ssm_pid=$!
    echo "$ssm_pid" > "$PID_FILE"
    
    echo "Waiting for connection... (Parent PID: $ssm_pid)"

    exec 3<>"$LOG_PIPE"
    FD_OPENED=true

    while IFS= read -r line <&3; do
        if [[ "$line" == "Waiting for connections..." ]]; then
            echo "✅ Port forwarding is ready."
            break
        fi
    done
fi

eval "$SSH_CMD"

# --- Conditional Cleanup ---
active_ssh_sessions=$(pgrep -fc "$SSH_CMD")

if [ "$active_ssh_sessions" -eq 0 ]; then
    echo "🧹 This was the last SSH session. Cleaning up..."
    
    ssm_pid_to_kill=$(cat "$PID_FILE")
    
    if [ -n "$ssm_pid_to_kill" ] && kill -0 "$ssm_pid_to_kill" >/dev/null 2>&1; then
        pkill -TERM -P "$ssm_pid_to_kill"
    fi
    
    if [ "$FD_OPENED" = true ]; then
        exec 3<&-
    fi

    rm -f "$PID_FILE" "$LOG_PIPE"
else
    echo "🤝 $active_ssh_sessions other SSH session(s) are still active. Leaving port forwarding running."
fi

