#!/usr/bin/env bash
# Display Hyprland keybindings with fzf search

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# Get binds from hyprctl as JSON
BIND_OUTPUT=$(hyprctl binds -j 2>/dev/null)

if [[ -z "$BIND_OUTPUT" ]]; then
    echo -e "${RED}Error: Could not get binds from hyprctl${RESET}"
    exit 1
fi

# Keycode to number mapping
get_keycode_num() {
    case $1 in
        10) echo "1" ;;
        11) echo "2" ;;
        12) echo "3" ;;
        13) echo "4" ;;
        14) echo "5" ;;
        15) echo "6" ;;
        16) echo "7" ;;
        17) echo "8" ;;
        18) echo "9" ;;
        19) echo "10" ;;
        *) echo "$1" ;;
    esac
}

# Format key display
format_key() {
    local key=$1
    local code=$2
    local has_super=$3
    
    if [[ -z "$key" || "$key" == "null" ]]; then
        [[ "$has_super" == "1" ]] && echo "$(get_keycode_num $code)" || echo "KC$code"
    else
        case "$key" in
            "mouse_down") echo "Scroll↓" ;;
            "mouse_up") echo "Scroll↑" ;;
            "left") echo "←" ;;
            "right") echo "→" ;;
            "up") echo "↑" ;;
            "down") echo "↓" ;;
            "SPACE") echo "Space" ;;
            "ESCAPE") echo "Esc" ;;
            "RETURN") echo "Enter" ;;
            "PRINT") echo "PrtSc" ;;
            "minus") echo "-" ;;
            "equal") echo "=" ;;
            "grave") echo "\`" ;;
            "apostrophe") echo "'" ;;
            "LEFT") echo "←" ;;
            "RIGHT") echo "→" ;;
            "UP") echo "↑" ;;
            "DOWN") echo "↓" ;;
            *) echo "$key" ;;
        esac
    fi
}

# Pad modifier glyph to align properly
#  (empty super) = 1 cell visual, 󰘶/󰘳/Alt = 2 cells visual
pad_mod() {
    local g=$1
    case "$g" in
        ) printf "%s " "$g" ;;   # 1 cell -> 2 cells with 1 pad
        󰘶|󰘳|Alt) printf "%s" "$g" ;;  # already 2 cells
        *) printf "%s" "$g" ;;
    esac
}

# Get modifier string with consistent spacing: "mod1  +  mod2  +  "
get_mods() {
    local mask=$1
    local mods=""
    
    if [[ $((mask & 64)) -eq 64 ]]; then
        mods+="$(pad_mod )  +  "
    fi
    if [[ $((mask & 1)) -eq 1 ]]; then
        [[ -n "$mods" ]] && mods+=""
        mods+="$(pad_mod 󰘶)  +  "
    fi
    if [[ $((mask & 8)) -eq 8 ]]; then
        [[ -n "$mods" ]] && mods+=""
        mods+="$(pad_mod Alt)  +  "
    fi
    if [[ $((mask & 4)) -eq 4 ]]; then
        [[ -n "$mods" ]] && mods+=""
        mods+="$(pad_mod 󰘳)  +  "
    fi
    
    echo -n "${mods}"
}

# Format category
format_category() {
    local disp=$1
    local arg=$2
    
    case "$disp" in
        "exec") echo "launch" ;;
        "workspace") echo "workspace" ;;
        "movetoworkspace") echo "workspace" ;;
        "movefocus") echo "navigate" ;;
        "swapwindow") echo "navigate" ;;
        "resizeactive") echo "resize" ;;
        "killactive") echo "window" ;;
        "togglefloating") echo "window" ;;
        "fullscreen") echo "window" ;;
        "togglesplit") echo "window" ;;
        "pseudo") echo "window" ;;
        "movecurrentworkspacetomonitor") echo "workspace" ;;
        *) echo "$disp" ;;
    esac
}

# Generate all binds as tab-separated lines
generate_binds() {
    echo "$BIND_OUTPUT" | jq -c '.[]' 2>/dev/null | while read -r bind; do
        modmask=$(echo "$bind" | jq -r '.modmask')
        key=$(echo "$bind" | jq -r '.key')
        keycode=$(echo "$bind" | jq -r '.keycode // 0')
        desc=$(echo "$bind" | jq -r '.description // empty')
        disp=$(echo "$bind" | jq -r '.dispatcher')
        arg=$(echo "$bind" | jq -r '.arg // empty')
        
        # Skip mouse move/resize and media keys
        [[ "$disp" == "mouse" ]] && continue
        [[ "$key" == "XF86"* ]] && continue
        
        # Generate description if missing
        if [[ -z "$desc" || "$desc" == "null" || "$desc" == '""' ]]; then
            case "$disp" in
                "exec") 
                    cmd=$(echo "$arg" | awk '{print $1}' | xargs basename 2>/dev/null)
                    desc="${cmd:0:25}"
                    ;;
                "workspace") desc="switch workspace" ;;
                "movetoworkspace") desc="move to workspace" ;;
                "movefocus") desc="focus window" ;;
                "swapwindow") desc="swap window" ;;
                "resizeactive") desc="resize window" ;;
                "killactive") desc="close window" ;;
                "togglefloating") desc="toggle floating" ;;
                "fullscreen") desc="toggle fullscreen" ;;
                "togglesplit") desc="toggle split" ;;
                "pseudo") desc="toggle pseudotile" ;;
                "movecurrentworkspacetomonitor") desc="move to monitor" ;;
                *) desc="" ;;
            esac
        fi
        desc="${desc//\"/}"
        
        mods=$(get_mods "$modmask")
        has_super=0
        [[ "$mods" == *""* ]] && has_super=1
        keyname=$(format_key "$key" "$keycode" "$has_super")
        category=$(format_category "$disp" "$arg")
        
        # Format: keybind | category | description
        echo -e "${mods}${keyname}\t${category}\t${desc}"
    done
}

# Run fzf
generate_binds | column -t -s $'\t' -o '       ' | fzf \
    --ansi \
    --height=100% \
    --layout=reverse \
    --prompt='Search: ' \
    --header='  KEYBINDINGS' \
    --header-border=rounded \
    --header-first \
    --no-preview \
    --color=header:bold:yellow \
    --color=prompt:green \
    --color=fg:white \
    --color=fg+:white,bg+:#3c3836 \
    --color=pointer:#fabd2f \
    --color=marker:green \
    --color=info:blue \
    --color=spinner:yellow \
    --color=hl:#fabd2f \
    --color=hl+:#fabd2f 
