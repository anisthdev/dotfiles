#!/usr/bin/env bash
# Display Hyprland keybindings with rofi search

SCRIPT_DIR="$(dirname "$0")"
theme="$SCRIPT_DIR/styles/common-menu.rasi"

# Get binds from hyprctl as JSON
BIND_OUTPUT=$(hyprctl binds -j 2>/dev/null)

if [[ -z "$BIND_OUTPUT" ]]; then
    echo "Error: Could not get binds from hyprctl"
    exit 1
fi

# Keycode to number mapping
get_keycode_num() {
    case $1 in
        10) echo "1" ;;
        11) echo "2" ;;
        12) echo "3" ;;
        13) echo "4" ;;
        14) echo "5" ;;
        15) echo "6" ;;
        16) echo "7" ;;
        17) echo "8" ;;
        18) echo "9" ;;
        19) echo "10" ;;
        *) echo "$1" ;;
    esac
}

# Format key display
format_key() {
    local key=$1
    local code=$2
    local has_super=$3

    if [[ -z "$key" || "$key" == "null" ]]; then
        [[ "$has_super" == "1" ]] && echo "$(get_keycode_num $code)" || echo "KC$code"
    else
        case "$key" in
            "mouse_down") echo "Scroll↓" ;;
            "mouse_up") echo "Scroll↑" ;;
            "left") echo "←" ;;
            "right") echo "→" ;;
            "up") echo "↑" ;;
            "down") echo "↓" ;;
            "SPACE") echo "Space" ;;
            "ESCAPE") echo "Esc" ;;
            "RETURN") echo "Enter" ;;
            "PRINT") echo "PrtSc" ;;
            "minus") echo "-" ;;
            "equal") echo "=" ;;
            "grave") echo "\`" ;;
            "apostrophe") echo "'" ;;
            "LEFT") echo "←" ;;
            "RIGHT") echo "→" ;;
            "UP") echo "↑" ;;
            "DOWN") echo "↓" ;;
            *) echo "$key" ;;
        esac
    fi
}

# Pad modifier glyph to align properly
pad_mod() {
    local g=$1
    case "$g" in
        ) printf "%s " "$g" ;;
        󰘶|󰘳|Alt) printf "%s" "$g" ;;
        *) printf "%s" "$g" ;;
    esac
}

# Get modifier string with consistent spacing
get_mods() {
    local mask=$1
    local mods=""

    if [[ $((mask & 64)) -eq 64 ]]; then
        mods+="$(pad_mod ) + "
    fi
    if [[ $((mask & 1)) -eq 1 ]]; then
        mods+="$(pad_mod 󰘶) + "
    fi
    if [[ $((mask & 8)) -eq 8 ]]; then
        mods+="$(pad_mod Alt) + "
    fi
    if [[ $((mask & 4)) -eq 4 ]]; then
        mods+="$(pad_mod 󰘳) + "
    fi

    echo -n "${mods}"
}

# Format category
format_category() {
    local disp=$1
    local arg=$2

    case "$disp" in
        "exec") echo "launch" ;;
        "workspace") echo "workspace" ;;
        "movetoworkspace") echo "workspace" ;;
        "movefocus") echo "navigate" ;;
        "swapwindow") echo "navigate" ;;
        "resizeactive") echo "resize" ;;
        "killactive") echo "window" ;;
        "togglefloating") echo "window" ;;
        "fullscreen") echo "window" ;;
        "togglesplit") echo "window" ;;
        "pseudo") echo "window" ;;
        "movecurrentworkspacetomonitor") echo "workspace" ;;
        *) echo "$disp" ;;
    esac
}

# Collect binds into arrays
bind_rows=()
while IFS= read -r bind; do
    bind_rows+=("$bind")
done < <(echo "$BIND_OUTPUT" | jq -r '.[] | [.modmask, (.key // ""), (.keycode // 0), (.description // ""), .dispatcher, (.arg // "")] | @tsv' 2>/dev/null)

# Process binds and find max widths
keybinds=()
categories=()
descs=()
max_keybind=0
max_cat=0
skipped_mouse=0
skipped_media=0

for bind in "${bind_rows[@]}"; do
    IFS=$'\t' read -r modmask key keycode desc disp arg <<< "$bind"

    # Skip mouse move/resize and media keys
    if [[ "$disp" == "mouse" ]]; then
        skipped_mouse=$((skipped_mouse + 1))
        continue
    fi
    if [[ "$key" == "XF86"* ]]; then
        skipped_media=$((skipped_media + 1))
        continue
    fi

    # Generate description if missing
    if [[ -z "$desc" || "$desc" == "null" || "$desc" == '""' ]]; then
        case "$disp" in
            "exec")
                cmd="${arg%% *}"
                cmd="${cmd##*/}"
                desc="${cmd:0:25}"
                ;;
            "workspace") desc="switch workspace" ;;
            "movetoworkspace") desc="move to workspace" ;;
            "movefocus") desc="focus window" ;;
            "swapwindow") desc="swap window" ;;
            "resizeactive") desc="resize window" ;;
            "killactive") desc="close window" ;;
            "togglefloating") desc="toggle floating" ;;
            "fullscreen") desc="toggle fullscreen" ;;
            "togglesplit") desc="toggle split" ;;
            "pseudo") desc="toggle pseudotile" ;;
            "movecurrentworkspacetomonitor") desc="move to monitor" ;;
            *) desc="" ;;
        esac
    fi
    desc="${desc//\"/}"

    mods=$(get_mods "$modmask")
    has_super=0
    [[ "$mods" == *""* ]] && has_super=1
    keyname=$(format_key "$key" "$keycode" "$has_super")
    category=$(format_category "$disp" "$arg")

    keybind="${mods}${keyname}"
    keybinds+=("$keybind")
    categories+=("$category")
    descs+=("$desc")

    [[ ${#keybind} -gt $max_keybind ]] && max_keybind=${#keybind}
    [[ ${#category} -gt $max_cat ]] && max_cat=${#category}
done

# Generate formatted output
output=()
for ((i=0; i<${#keybinds[@]}; i++)); do
    keybind="${keybinds[$i]}"
    category="${categories[$i]}"
    desc="${descs[$i]}"
    pad_keybind=$((max_keybind - ${#keybind} + 1))
    pad_cat=$((max_cat - ${#category} + 1))
    output+=("$(printf "%s%*s %s%*s %s" "$keybind" "$pad_keybind" "" "$category" "$pad_cat" "" "$desc")")
done

# Run rofi
font="'SF Mono 14'"
printf '%s\n' "${output[@]}" | rofi -dmenu -i -p " " -mesg "Keybindings" \
  -theme-str "configuration { show-icons: false; } element { children: [ element-text ]; } element-text { font: $font;} window {width: 650px;} inputbar {enabled: true;} entry {placeholder: 'Search...';}" \
  -theme "$theme"
