#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
THEME="$SCRIPT_DIR/styles/entertainment.rasi"

labels=(
    "Play URL"
    "Telegram Media"
    "Movies/TV"
    "Hindi Movies"
    "Anime"
    "Ebooks"
    "RetroArch NES"
    "Playlists"
)

commands=(
    "$SCRIPT_DIR/play-video"
    "$SCRIPT_DIR/telegram-media"
    "$SCRIPT_DIR/movie-search"
    "$SCRIPT_DIR/hindi-movie-search"
    "$SCRIPT_DIR/anime-search"
    "$SCRIPT_DIR/ebook-search"
    "$SCRIPT_DIR/retroarch-nes"
    "$SCRIPT_DIR/playlist"
)

icons=(
    "mpv"
    "telegram"
    "video-x-generic"
    "video-x-generic"
    "kawanime"
    "accessories-ebook-reader"
    "retroarch"
    "playlist"
)

menu_rows() {
    local index
    for index in "${!labels[@]}"; do
        printf '%s\0icon\x1f%s\n' "${labels[$index]}" "${icons[$index]}"
    done
}

if ! selected_index="$(
    menu_rows | rofi \
        -dmenu \
        -i \
        -format i \
        -p " " \
        -mesg "󱂬  Entertainment" \
        -theme "$THEME"
)"; then
    exit 0
fi

[[ -n "$selected_index" ]] || exit 0

exec "${commands[$selected_index]}"
