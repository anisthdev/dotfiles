#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export JACKETT_INDEXER="${JACKETT_INDEXER:-tag:movies}"
export JACKETT_SEARCH_TYPE="${JACKETT_SEARCH_TYPE:-search}"
export JACKETT_CATEGORY="${JACKETT_CATEGORY:-2000,5000}"
export JACKETT_TV_CATEGORY="${JACKETT_TV_CATEGORY:-5000}"
export JACKETT_SEARCH_LABEL="${JACKETT_SEARCH_LABEL:-movies}"
export JACKETT_SELECT_LABEL="${JACKETT_SELECT_LABEL:-movie}"
export JACKETT_EMPTY_LABEL="${JACKETT_EMPTY_LABEL:-movie results}"
export JACKETT_TITLE_FALLBACK="${JACKETT_TITLE_FALLBACK:-Movie}"
export JACKETT_TMP_PREFIX="${JACKETT_TMP_PREFIX:-jackett-movie}"

exec "$SCRIPT_DIR/jackett-search" "$@"
