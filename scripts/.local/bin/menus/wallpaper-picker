#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
THEME="$SCRIPT_DIR/styles/wallpaper-picker.rasi"
WALLPAPER_DIR="$HOME/Wallpapers"
CACHE_DIR="$HOME/.cache/wallpaper-picker"

find_wallpapers() {
    find "$WALLPAPER_DIR" -maxdepth 1 -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) \
        -print0 | sort -z
}

create_thumbnail() {
    local image="$1"
    local thumbnail="$CACHE_DIR/$(basename -- "$image")"

    if [[ ! -f "$thumbnail" || "$image" -nt "$thumbnail" ]]; then
        magick "$image" -strip -thumbnail 500x500^ -gravity center -extent 500x500 "$thumbnail"
    fi

    printf '%s' "$thumbnail"
}

print_rofi_rows() {
    local image thumbnail

    while IFS= read -r -d '' image; do
        thumbnail="$(create_thumbnail "$image")"
        printf '%s\0icon\x1f%s\n' "$(basename -- "$image")" "$thumbnail"
    done < <(find_wallpapers)
}

if [[ ! -d "$WALLPAPER_DIR" ]]; then
    printf 'Wallpaper directory does not exist: %s\n' "$WALLPAPER_DIR" >&2
    exit 1
fi

mkdir -p "$CACHE_DIR"

selection="$(
    print_rofi_rows | rofi -dmenu -theme "$THEME"
)" || exit 0

[[ -n "$selection" ]] || exit 0

exec matugen --type scheme-expressive image "$WALLPAPER_DIR/$selection" --source-color-index 0
