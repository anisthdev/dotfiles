#!/usr/bin/env bash

SCRIPT_DIR="$(dirname "$0")"
theme="$SCRIPT_DIR/styles/small-menu.rasi"

# Theme Elements
prompt='Screenshot'

list_col='4'
win_width='400px'

# Options
option_1=""
option_2=""
option_3=""
option_4=""

# Rofi CMD
rofi_cmd() {
	rofi -theme-str "window {width: $win_width;} listview {columns: $list_col;}" \
		-dmenu \
		-markup-rows \
		-theme ${theme}
}

# Pass variables to rofi dmenu
run_rofi() {
	echo -e "$option_1\n$option_2\n$option_3\n$option_4" | rofi_cmd
}

# countdown
countdown () {
    for sec in `seq $1 -1 1`; do
        notify-send \
            --hint=string:x-dunst-stack-tag:shot \
            --hint=string:synchronous:shot \
            "Taking shot in : $sec"
        sleep 1
	done
   makoctl dismiss
}

# Play shutter sound
play_shutter() {
    pw-play ~/.local/share/sounds/macos/camera-shutter.ogg &
}

# Actions
chosen="$(run_rofi)"
case ${chosen} in
    $option_1)
		hyprshot -m output; play_shutter
        ;;
    $option_2)
		hyprshot -m region; play_shutter
        ;;
    $option_3)
        hyprshot -m window; play_shutter
        ;;
    $option_4)
        countdown '5'
        hyprshot -m output; play_shutter
        ;;
esac
