#!/usr/bin/env bash

# Import Current Theme
SCRIPT_DIR="$(dirname "$0")"
theme=$SCRIPT_DIR/styles/small-menu.rasi

# Options
option_1=""
option_2=""
option_3=""
option_4=""
option_5=""

list_col='5'
win_width='500px'

# Rofi CMD
rofi_cmd() {
	rofi -dmenu -u 4 -markup-rows -theme-str "window {width: $win_width;} listview {columns: $list_col;}" -theme ${theme}
}

# Pass variables to rofi dmenu
run_rofi() {
	echo -e "$option_1
$option_2
$option_3
$option_4
$option_5" | rofi_cmd
}

run_cmd() {
	if [[ "$1" == '--opt1' ]]; then
		hyprlock
	elif [[ "$1" == '--opt2' ]]; then
		mpc -q pause && systemctl suspend
	elif [[ "$1" == '--opt3' ]]; then
		systemctl hibernate
	elif [[ "$1" == '--opt4' ]]; then
		systemctl reboot
	elif [[ "$1" == '--opt5' ]]; then
		systemctl poweroff
	fi
}

# Actions
chosen="$(run_rofi)"
case ${chosen} in
    $option_1)
		run_cmd --opt1
        ;;
    $option_2)
		run_cmd --opt2
        ;;
    $option_3)
		run_cmd --opt3
        ;;
    $option_4)
		run_cmd --opt4
        ;;
    $option_5)
		run_cmd --opt5
        ;;
esac

