#!/usr/bin/env bash
set -euo pipefail

TRAY_ID="vpn"
TRAY_ICON="network-vpn"
IPINFO_TOKEN="${IPINFO_TOKEN:-${IPINFO_API_TOKEN:-}}"

current_vpn_names() {
  nmcli -t -f NAME,TYPE,STATE connection show 2>/dev/null \
    | awk -F: '$2=="vpn" && $3=="activated" {print $1}' \
    | paste -sd ', ' -
}

current_vpn_location() {
  local url json country region city region_city

  if ! command -v jq >/dev/null 2>&1; then
    return 0
  fi

  url="https://ipinfo.io/json"
  if [[ -n "$IPINFO_TOKEN" ]]; then
    url="${url}?token=${IPINFO_TOKEN}"
  fi

  json="$(curl -fsS --max-time 5 "$url" 2>/dev/null || true)"
  [[ -z "$json" ]] && return 0

  country="$(printf '%s' "$json" | jq -r '.country // empty' 2>/dev/null || true)"
  region="$(printf '%s' "$json" | jq -r '.region // empty' 2>/dev/null || true)"
  city="$(printf '%s' "$json" | jq -r '.city // empty' 2>/dev/null || true)"

  region_city=""
  if [[ -n "$region" && -n "$city" ]]; then
    region_city="$region / $city"
  elif [[ -n "$region" ]]; then
    region_city="$region"
  elif [[ -n "$city" ]]; then
    region_city="$city"
  fi

  if [[ -n "$country" && -n "$region_city" ]]; then
    printf '%s, %s' "$country" "$region_city"
  elif [[ -n "$country" ]]; then
    printf '%s' "$country"
  else
    printf '%s' "$region_city"
  fi
}

show_vpn_tray() {
  local names="$1"
  local tooltip location

  tooltip="VPN active: $names"
  location="$(current_vpn_location)"
  if [[ -n "$location" ]]; then
    tooltip+=$'\n'"Location: $location"
  fi

  tray show --id "$TRAY_ID" --icon "$TRAY_ICON" --tooltip "$tooltip" >/dev/null 2>&1 || true
}

hide_vpn_tray() {
  tray hide --id "$TRAY_ID" >/dev/null 2>&1 || true
}

cleanup() {
  hide_vpn_tray
}

trap cleanup EXIT INT TERM

if ! command -v nmcli >/dev/null 2>&1; then
  exit 0
fi

if ! command -v tray >/dev/null 2>&1; then
  exit 0
fi

last_state=""

while true; do
  vpn_names="$(current_vpn_names)"

  if [[ "$vpn_names" != "$last_state" ]]; then
    if [[ -n "$vpn_names" ]]; then
      show_vpn_tray "$vpn_names"
    else
      hide_vpn_tray
    fi
    last_state="$vpn_names"
  fi

  sleep 2
done
