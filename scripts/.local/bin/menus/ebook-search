#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export JACKETT_INDEXER="${JACKETT_INDEXER:-tag:books}"
export JACKETT_SEARCH_TYPE="${JACKETT_SEARCH_TYPE:-book}"
export JACKETT_CATEGORY="${JACKETT_CATEGORY:-7000,7020,7030}"
export JACKETT_SEARCH_LABEL="${JACKETT_SEARCH_LABEL:-ebooks}"
export JACKETT_SELECT_LABEL="${JACKETT_SELECT_LABEL:-ebook}"
export JACKETT_EMPTY_LABEL="${JACKETT_EMPTY_LABEL:-ebook results}"
export JACKETT_TITLE_FALLBACK="${JACKETT_TITLE_FALLBACK:-Ebook}"
export JACKETT_TMP_PREFIX="${JACKETT_TMP_PREFIX:-jackett-ebook}"

exec "$SCRIPT_DIR/jackett-search" "$@"
