#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$0")"
theme="$HOME/.config/rofi/bluetooth-menu.rasi"

rofi_menu_cmd() {
    rofi -dmenu -i -format i -markup-rows -p "System Controls" \
        -mesg "Quick Actions" \
        -theme "$theme"
}

escape_markup() {
    local text="$1"
    text="${text//&/&amp;}"
    text="${text//</&lt;}"
    text="${text//>/&gt;}"
    printf '%s' "$text"
}

declare -a actions=()
declare -a scripts=()
declare -a menu_items=()

actions+=("Audio")
scripts+=("audio-switcher")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Audio</span>")

actions+=("Wifi")
scripts+=("wifi")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Wifi</span>")

actions+=("Bluetooth")
scripts+=("bluetooth")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Bluetooth</span>")

actions+=("Wallpaper")
scripts+=("wallpaper-picker")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Wallpaper</span>")

actions+=("Screenshot")
scripts+=("screenshot")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Screenshot</span>")

actions+=("Screenrecord")
scripts+=("screenrecord")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Screenrecord</span>")

actions+=("Power")
scripts+=("power-menu")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Power</span>")

actions+=("Nightlight")
scripts+=("toggle-nightlight")
menu_items+=("<span font_family='lucide' size='larger'></span>   <span font_family='SF Pro Display' font_weight='bold'>Nightlight</span>")

rofi_status=0
choice_idx=""
set +e
choice_idx="$(printf '%s\n' "${menu_items[@]}" | rofi_menu_cmd)"
rofi_status=$?
set -e

[[ -z "$choice_idx" ]] && exit 0

script="${scripts[$choice_idx]}"
# Check parent dir for toggles (toggle-*)
if [[ "$script" == toggle-* ]]; then
    exec "$SCRIPT_DIR/../$script"
else
    exec "$SCRIPT_DIR/$script"
fi
