#!/usr/bin/env bash
# Toggle Do Not Disturb mode

state=$(makoctl mode)

if [[ "$state" == *"do-not-disturb"* ]]; then
    makoctl mode -s default
    notify-send "DND" "Disabled" -i preferences-desktop-notifications
else
    makoctl mode -s do-not-disturb
    notify-send "DND" "Enabled" -i notifications-disabled
fi