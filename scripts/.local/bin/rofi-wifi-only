#!/usr/bin/env bash
set -euo pipefail

if ! command -v nmcli >/dev/null 2>&1 || ! command -v rofi >/dev/null 2>&1; then
  notify-send "Wi-Fi menu unavailable" "Missing nmcli or rofi"
  exit 1
fi

if [[ "$(nmcli -t -f WIFI g 2>/dev/null)" != "enabled" ]]; then
  nmcli radio wifi on || {
    notify-send "Wi-Fi" "Failed to enable Wi-Fi"
    exit 1
  }
fi

notify-send -u low -t 1200 "Wi-Fi" "Scanning networks..."

declare -A best_signal=()
declare -A is_active=()
declare -A has_security=()

rofi_menu_cmd() {
  rofi -dmenu -i -format i -markup-rows -p "󰍉" \
    -kb-custom-1 "c" \
    -kb-custom-2 "f" \
    -theme-str 'window { location: northeast; anchor: northeast; x-offset: -10px; y-offset: 10px; }' \
    -theme-str 'prompt { font: "monospace 13"; }'
}

wifi_icon_for_signal() {
  local signal="$1"
  if (( signal >= 55 )); then
    printf ''
  elif (( signal >= 35 )); then
    printf ''
  elif (( signal >= 15 )); then
    printf ''
  elif (( signal >= 0 )); then
    printf ''
  else
    printf ''
  fi
}

escape_markup() {
  local text="$1"
  text="${text//&/&amp;}"
  text="${text//</&lt;}"
  text="${text//>/&gt;}"
  printf '%s' "$text"
}

mapfile -t lines < <(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan yes)

for line in "${lines[@]}"; do
  inuse="${line%%:*}"
  rest="${line#*:}"
  ssid="${rest%%:*}"
  rest="${rest#*:}"
  signal="${rest%%:*}"
  security="${rest#*:}"

  # Trim whitespace in case nmcli emits leading spaces for non-active rows.
  inuse="${inuse#"${inuse%%[![:space:]]*}"}"
  inuse="${inuse%"${inuse##*[![:space:]]}"}"
  ssid="${ssid#"${ssid%%[![:space:]]*}"}"
  ssid="${ssid%"${ssid##*[![:space:]]}"}"

  # Unescape nmcli terse-field escaping.
  ssid="${ssid//\\:/:}"
  security="${security//\\:/:}"

  [[ -z "${ssid// }" ]] && continue

  [[ "$signal" =~ ^[0-9]+$ ]] || signal=0
  if [[ -z "${best_signal[$ssid]:-}" || "$signal" -gt "${best_signal[$ssid]}" ]]; then
    best_signal["$ssid"]="$signal"
  fi

  if [[ "$inuse" == "*" ]]; then
    is_active["$ssid"]=1
  fi

  if [[ -n "${security// }" && "$security" != "--" ]]; then
    has_security["$ssid"]=1
  fi
done

if [[ ${#best_signal[@]} -eq 0 ]]; then
  notify-send "Wi-Fi" "No networks found"
  exit 0
fi

mapfile -t sorted_rows < <(
  for ssid in "${!best_signal[@]}"; do
    signal="${best_signal[$ssid]}"
    icon="$(wifi_icon_for_signal "$signal")"
    ssid_escaped="$(escape_markup "$ssid")"
    icon_markup="<span font_family='lucide'>$icon</span>"
    active_prefix=""
    secure_icon=""

    if [[ "${is_active[$ssid]:-0}" -eq 1 ]]; then
      active_prefix="󰄬 "
    fi

    if [[ "${has_security[$ssid]:-0}" -eq 1 ]]; then
      secure_icon="󰌾"
    fi

    visible_label="${active_prefix}${icon}  ${ssid}"
    printf '%03d\t%s\t%s%s  %s\t%d\t%s\n' "$signal" "$ssid" "$active_prefix" "$icon_markup" "$ssid_escaped" "${#visible_label}" "$secure_icon"
  done | sort -rn
)

menu_items=()
ssids=()
left_labels=()
left_visible_lens=()
secure_icons=()
max_visible_len=0

for row in "${sorted_rows[@]}"; do
  IFS=$'\t' read -r _ ssid left_label left_visible_len secure_icon <<< "$row"
  ssids+=("$ssid")
  left_labels+=("$left_label")
  left_visible_lens+=("$left_visible_len")
  secure_icons+=("$secure_icon")
  if (( left_visible_len > max_visible_len )); then
    max_visible_len="$left_visible_len"
  fi
done

for i in "${!left_labels[@]}"; do
  right_pad=$((max_visible_len - left_visible_lens[$i] + 2))
  if [[ -n "${secure_icons[$i]}" ]]; then
    menu_items+=("$(printf "%s%*s%s" "${left_labels[$i]}" "$right_pad" "" "${secure_icons[$i]}")")
  else
    menu_items+=("${left_labels[$i]}")
  fi
done

connect_to_ssid() {
  local target_ssid="$1"
  if nmcli device wifi connect "$target_ssid" >/dev/null 2>&1; then
    notify-send "Wi-Fi" "Connected to $target_ssid"
    return 0
  fi

  password="$(rofi -dmenu -password -p "󰌾" \
    -theme-str 'prompt { font: "monospace 13"; }' \
    -theme-str 'entry { placeholder: ""; }')"
  [[ -z "$password" ]] && return 1

  if nmcli device wifi connect "$target_ssid" password "$password" >/dev/null 2>&1; then
    notify-send "Wi-Fi" "Connected to $target_ssid"
    return 0
  fi

  notify-send "Wi-Fi" "Failed to connect to $target_ssid"
  return 1
}

disconnect_selected_wifi() {
  local target_ssid="$1"
  local wifi_dev
  if [[ "${is_active[$target_ssid]:-0}" -ne 1 ]]; then
    return 1
  fi

  wifi_dev="$(nmcli -t -f DEVICE,TYPE,STATE device | awk -F: '$2=="wifi" && $3 ~ /^connected/ {print $1; exit}')"
  [[ -z "$wifi_dev" ]] && return 1

  if nmcli device disconnect "$wifi_dev" >/dev/null 2>&1; then
    notify-send "Wi-Fi" "Disconnected from $target_ssid"
    return 0
  fi

  notify-send "Wi-Fi" "Failed to disconnect $target_ssid"
  return 1
}

forget_ssid_profiles() {
  local target_ssid="$1"
  local deleted=0

  while IFS=: read -r uuid name type; do
    name="${name//\\:/:}"
    if [[ "$type" == "802-11-wireless" && "$name" == "$target_ssid" ]]; then
      if nmcli connection delete uuid "$uuid" >/dev/null 2>&1; then
        deleted=$((deleted + 1))
      fi
    fi
  done < <(nmcli -t -f UUID,NAME,TYPE connection show)

  if (( deleted > 0 )); then
    notify-send "Wi-Fi" "Forgot $target_ssid ($deleted profile(s))"
    return 0
  fi

  notify-send "Wi-Fi" "No saved profile for $target_ssid"
  return 1
}

rofi_status=0
choice_idx=""
set +e
choice_idx="$(printf '%s\n' "${menu_items[@]}" | rofi_menu_cmd)"
rofi_status=$?
set -e

[[ -z "$choice_idx" ]] && exit 0

ssid="${ssids[$choice_idx]}"

case "$rofi_status" in
  0)
    if [[ "${is_active[$ssid]:-0}" -eq 1 ]]; then
      notify-send "Wi-Fi" "Already connected to $ssid"
      exit 0
    fi
    connect_to_ssid "$ssid"
    ;;
  10)
    if [[ "${is_active[$ssid]:-0}" -eq 1 ]]; then
      disconnect_selected_wifi "$ssid" || true
    else
      connect_to_ssid "$ssid" || true
    fi
    ;;
  11)
    if [[ "${is_active[$ssid]:-0}" -eq 1 ]]; then
      disconnect_selected_wifi "$ssid" || true
    fi
    forget_ssid_profiles "$ssid" || true
    ;;
  *)
    exit 0
    ;;
esac
