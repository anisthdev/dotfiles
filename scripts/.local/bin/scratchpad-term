#!/usr/bin/env bash

client_exists() {
    hyprctl -j clients | jq -e --arg t "$1" 'any(.[]; .initialClass == $t)' > /dev/null 2>&1
}

TITLE="scratchpad-term"

if ! client_exists "$TITLE"; then
    uwsm app -- foot --app-id="$TITLE" --title="$TITLE" &
    until client_exists "$TITLE"; do sleep 0.1; done
fi

hyprctl dispatch togglespecialworkspace term
