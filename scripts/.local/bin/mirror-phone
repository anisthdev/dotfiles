#!/usr/bin/env bash
# Mirror the phone with scrcpy over whichever link phone-connect finds.
# Extra arguments are passed on to scrcpy.
set -euo pipefail

# scrcpy must use the same adb as the running server, or they kill each other
export ADB="$HOME/.sdks/android/platform-tools/adb"

serial="$(busy --icon phone "Connecting to phone" -- "$HOME/.local/bin/phone-connect")" || exit 1

# USB has bandwidth to spare; Wi-Fi and the hotspot need a lighter stream
[[ "$serial" == *:* || "$serial" == *_adb-tls-connect* ]] && bitrate=8M || bitrate=16M

# A session whose network went away keeps its server running on the phone,
# holding the encoder so the new one shows a blank window
timeout 3 "$ADB" -s "$serial" shell pkill -f com.genymobile.scrcpy.Server </dev/null || true

exec scrcpy --serial="$serial" \
    --window-title="Pixel 10a" \
    --video-codec=h265 --max-size=1920 --video-bit-rate="$bitrate" \
    --keyboard=uhid \
    --turn-screen-off --stay-awake --power-off-on-close \
    "$@"
