#!/usr/bin/env bash
if ! command -v yq &> /dev/null; then
    echo 'Error: command yq not found'
    exit 1
fi

if [ -z $SESSHIN_DIR ]; then
    echo "Error: No configuration directory found. Please set \$SESSHIN_DIR"
    exit 1
fi

CONFIG_FILE="$SESSHIN_DIR/servers.yml"
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: servers.yml not found in the configuration directory"
    exit 1
fi

if [ $# -lt 1 ]; then
    echo 'Usage: $0 <command>'
    exit 1
fi

# function to list all ec2-instances
list_instances ()
{
    if [[ "$1" == "--ssh" ]]; then
        yq -r '.[] | select(has("ssh")) | .name' "$CONFIG_FILE"  
    else
        yq -r '.[] | .name' "$CONFIG_FILE"
    fi
}

describe_instance ()
{
    yq -y ".[] | select(.name == \"$1\")" "$CONFIG_FILE" || echo "Error: invalid server name"
}

case "$1" in
    list)
        list_instances "$2"
        ;;
    describe)
        describe_instance "$2"
        ;;
    *)
        echo "Unknown command: $1"
        exit 1
        ;;
esac



