#!/usr/bin/env bash
# Run a command and show a progress card while it is still running.
#
#   busy [options] TITLE -- COMMAND [ARGS...]
#
# A wrapper for `inflight run` (~/Projects/inflight), kept so callers don't
# change. Nothing is shown if the command finishes within the delay. On
# success the card shows a check; on failure, the last line of stderr.
# Clicking a running card cancels the command. stdin, stdout, stderr and the
# exit code of COMMAND are passed through, so busy can wrap commands inside
# pipelines and $(...).
#
# Options:
#   -b, --body TEXT    secondary text, e.g. the search query
#   -i, --icon NAME    icon shown inside the spinner
#   -d, --delay SECS   time before the card appears (default: 0.3)
#   -q, --no-error     don't show a card on failure
exec inflight run "$@"
