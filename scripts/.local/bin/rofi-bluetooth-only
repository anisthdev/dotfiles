#!/usr/bin/env bash
set -euo pipefail

if ! command -v bluetoothctl >/dev/null 2>&1 || ! command -v rofi >/dev/null 2>&1; then
  notify-send "Bluetooth menu unavailable" "Missing bluetoothctl or rofi"
  exit 1
fi

theme="$HOME/.config/rofi/bluetooth-menu.rasi"
colors_rasi="$HOME/.config/rofi/colors.rasi"

connected_color="#C3CB97"  # fallback if colors.rasi is unavailable
if [[ -f "$colors_rasi" ]]; then
  tertiary_line="$(grep -E '^\s*tertiary:\s*rgba' "$colors_rasi" | head -n1)"
  if [[ "$tertiary_line" =~ rgba\(([0-9]+),\ *([0-9]+),\ *([0-9]+) ]]; then
    connected_color="$(printf '#%02X%02X%02X' \
      "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")"
  fi
fi

rofi_menu_cmd() {
  rofi -dmenu -i -format i -markup-rows -p "󰂯" \
    -mesg "Bluetooth" \
    -kb-custom-1 "c" \
    -kb-custom-2 "f" \
    -kb-custom-3 "r" \
    -theme "$theme"
}

escape_markup() {
  local text="$1"
  text="${text//&/&amp;}"
  text="${text//</&lt;}"
  text="${text//>/&gt;}"
  printf '%s' "$text"
}

if ! bluetoothctl show | grep -qE '^[[:space:]]*Powered:[[:space:]]+yes$'; then
  if ! bluetoothctl power on >/dev/null 2>&1; then
    notify-send "Bluetooth" "Failed to power on"
    exit 1
  fi
fi

bluetoothctl --timeout 4 scan on >/dev/null 2>&1 &

sleep 0.4

mapfile -t devices < <(bluetoothctl devices)
if [[ ${#devices[@]} -eq 0 ]]; then
  notify-send "Bluetooth" "No devices found"
  exit 0
fi

declare -a addrs=()
declare -a names=()
declare -a connected_flags=()
declare -a paired_flags=()
declare -a trusted_flags=()
declare -a device_types=()
declare -a left_labels=()

icon_for_bt_type() {
  local bt_type="$1"
  case "$bt_type" in
    input-mouse)
      printf '󰦋 '
      ;;
    input-keyboard)
      printf '󰥻 '
      ;;
    input-gaming|input-gamepad)
      printf '󰊴 '
      ;;
    audio-headphones)
      printf '󰋋 '
      ;;
    audio-headset)
      printf '󱡏 '
      ;;
    audio-card|audio-speaker)
      printf '󰦢 '
      ;;
    phone)
      printf '󰄜 '
      ;;
    computer)
      printf '󰌢 '
      ;;
    camera-photo|camera-video)
      printf '󰄀 '
      ;;
    printer)
      printf '󰐪 '
      ;;
    *)
      printf '󰀀 '
      ;;
  esac
}

for line in "${devices[@]}"; do
  [[ "$line" == Device\ * ]] || continue

  rest="${line#Device }"
  addr="${rest%% *}"
  name="${rest#* }"
  name="${name//$'\r'}"     # mapfile -t strips \n but not \r

  info="$(bluetoothctl info "$addr" 2>/dev/null || true)"

  # Prefer the Name field from info; fall back to the devices-line name, then "Unknown"
  # Discard any candidate that is itself a MAC address (some devices broadcast their address as name)
  is_mac() { [[ "$1" =~ ^([0-9A-Fa-f]{2}[:\-]){5}[0-9A-Fa-f]{2}$ ]]; }
  info_name="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Name:[[:space:]]*//p' | head -n1)"
  info_name="${info_name//$'\r'}"
  if [[ -n "${info_name// }" ]] && ! is_mac "$info_name"; then
    name="$info_name"
  elif is_mac "$name" || [[ -z "${name// }" ]]; then
    name="Unknown"
  fi

  connected=0
  paired=0
  trusted=0
  bt_type=""

  if printf '%s\n' "$info" | grep -qE '^[[:space:]]*Connected:[[:space:]]+yes$'; then
    connected=1
  fi
  if printf '%s\n' "$info" | grep -qE '^[[:space:]]*Paired:[[:space:]]+yes$'; then
    paired=1
  fi
  if printf '%s\n' "$info" | grep -qE '^[[:space:]]*Trusted:[[:space:]]+yes$'; then
    trusted=1
  fi
  bt_type="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Icon:[[:space:]]*//p' | head -n1)"

  addrs+=("$addr")
  names+=("$name")
  connected_flags+=("$connected")
  paired_flags+=("$paired")
  trusted_flags+=("$trusted")
  device_types+=("$bt_type")

done

for i in "${!addrs[@]}"; do
  name_escaped="$(escape_markup "${names[$i]}")"
  type_icon="$(icon_for_bt_type "${device_types[$i]}")"
  device_icon="$type_icon"

  if [[ "${connected_flags[$i]}" -eq 1 ]]; then
    left_label="<span foreground='${connected_color}'>${device_icon} <span font_family='SF Pro Display' font_weight='bold'>${name_escaped}</span></span>"
  else
    left_label="${device_icon} <span font_family='SF Pro Display' font_weight='bold'>${name_escaped}</span>"
  fi
  left_labels+=("$left_label")
done

menu_items=("${left_labels[@]}")

connect_device() {
  local addr="$1"
  local name="$2"
  if bluetoothctl connect "$addr" >/dev/null 2>&1; then
    notify-send "Bluetooth" "Connected to $name"
    return 0
  fi
  notify-send "Bluetooth" "Failed to connect $name"
  return 1
}

disconnect_device() {
  local addr="$1"
  local name="$2"
  if bluetoothctl disconnect "$addr" >/dev/null 2>&1; then
    notify-send "Bluetooth" "Disconnected $name"
    return 0
  fi
  notify-send "Bluetooth" "Failed to disconnect $name"
  return 1
}

forget_device() {
  local addr="$1"
  local name="$2"
  if bluetoothctl remove "$addr" >/dev/null 2>&1; then
    notify-send "Bluetooth" "Forgot $name"
    return 0
  fi
  notify-send "Bluetooth" "Failed to forget $name"
  return 1
}

rofi_status=0
choice_idx=""
set +e
choice_idx="$(printf '%s\n' "${menu_items[@]}" | rofi_menu_cmd)"
rofi_status=$?
set -e

[[ -z "$choice_idx" ]] && exit 0

addr="${addrs[$choice_idx]}"
name="${names[$choice_idx]}"
is_connected="${connected_flags[$choice_idx]}"

case "$rofi_status" in
  0)
    if [[ "$is_connected" -eq 1 ]]; then
      notify-send "Bluetooth" "Already connected to $name"
      exit 0
    fi
    connect_device "$addr" "$name" || true
    ;;
  10)
    if [[ "$is_connected" -eq 1 ]]; then
      disconnect_device "$addr" "$name" || true
    else
      connect_device "$addr" "$name" || true
    fi
    ;;
  11)
    if [[ "$is_connected" -eq 1 ]]; then
      disconnect_device "$addr" "$name" || true
    fi
    forget_device "$addr" "$name" || true
    ;;
  12)
    exec "$0"
    ;;
  *)
    exit 0
    ;;
esac
