#!/bin/bash

ICON_SELECT="󰆞"  # nf-fa-crop
ICON_WINDOW=""  # nf-fa-window_maximize
ICON_OUTPUT=""  # nf-fa-desktop

options="$ICON_SELECT\n$ICON_WINDOW\n$ICON_OUTPUT"

selected_icon=$(echo -e "$options" | rofi -dmenu -p "Screenshot" -theme ~/.config/rofi/screenshot-theme.rasi -no-config)

# Play shutter sound function
play_shutter() {
    pw-play ~/.local/share/sounds/macos/camera-shutter.ogg
}

# Check the selected icon and execute the corresponding command
case "$selected_icon" in
    "$ICON_SELECT")
        hyprshot -m region && play_shutter
        ;;
    "$ICON_WINDOW")
        hyprshot -m window && play_shutter
        ;;
    "$ICON_OUTPUT")
        hyprshot -m output && play_shutter
        ;;
esac
