# Common graphical session environment for UWSM-managed sessions.
export XCURSOR_THEME=Totoro
export XCURSOR_SIZE=24
export GDK_BACKEND='wayland,x11,*'
export GDK_SCALE=1
export QT_QPA_PLATFORM='wayland;xcb'
export QT_STYLE_OVERRIDE=kvantum
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland
export XCOMPOSEFILE="$HOME/.XCompose"
# GTK 4.24+ uses ext-background-effect to turn blur off on its windows, overriding Hyprland's blur
# https://github.com/hyprwm/Hyprland/discussions/16507
export GDK_WAYLAND_DISABLE=ext_background_effect_manager_v1

# Session-wide so apps launched from Hyprland (yazi via Super+Y, etc.) see it
export EDITOR=nvim
export VISUAL=nvim
