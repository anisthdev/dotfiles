{
  "document": {
    "background_color": "{{colors.background.default.hex}}",
    "color": "{{colors.on_background.default.hex}}",
    "margin": 2,
    "block_prefix": "\n"
  },
  "text": {
    "color": "{{colors.on_background.default.hex}}"
  },
  "paragraph": {},
  "heading": {
    "block_suffix": "\n",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "background_color": "{{colors.inverse_primary.default.hex}}",
    "color": "{{colors.on_surface.default.hex}}",
    "bold": true
  },
  "h2": {
    "color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "h3": {
    "color": "{{colors.secondary.default.hex}}",
    "bold": true
  },
  "h4": {
    "color": "{{colors.tertiary.default.hex}}",
    "bold": true
  },
  "h5": {
    "color": "{{colors.primary_fixed.default.hex}}",
    "bold": true
  },
  "h6": {
    "color": "{{colors.secondary_fixed.default.hex}}",
    "bold": true
  },
  "strong": {
    "color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "emph": {
    "color": "{{colors.tertiary.default.hex}}",
    "italic": true
  },
  "link": {
    "color": "{{colors.primary.default.hex}}",
    "underline": true
  },
  "link_text": {
    "color": "{{colors.secondary.default.hex}}",
    "bold": true
  },
  "block_quote": {
    "color": "{{colors.outline.default.hex}}",
    "italic": true
  },
  "code": {
    "background_color": "{{colors.surface_container.default.hex}}",
    "color": "{{colors.primary.default.hex}}"
  },
  "code_block": {
    "color": "{{colors.on_surface.default.hex}}"
  },
  "item": {
    "color": "{{colors.on_background.default.hex}}"
  },
  "enumeration": {
    "color": "{{colors.secondary.default.hex}}"
  },
  "table": {
    "color": "{{colors.on_background.default.hex}}"
  },
  "table_header": {
    "color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "hr": {
    "color": "{{colors.outline.default.hex}}"
  }
}
