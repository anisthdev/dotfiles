/* hyprland-share-picker (Qt widgets), loaded by ~/.local/bin/share-picker */

QWidget {
  background-color: {{colors.surface_container_low.default.hex}};
  color: {{colors.on_surface.default.hex}};
  font-size: 10.5pt;
}

QTabWidget::pane {
  border: none;
  margin-top: 8px;
}

QTabWidget::tab-bar {
  alignment: center;
}

QTabBar::tab {
  background: transparent;
  color: {{colors.on_surface_variant.default.hex}};
  border: none;
  border-radius: 14px;
  padding: 6px 18px;
  margin: 0 2px;
}

QTabBar::tab:hover {
  background-color: {{colors.surface_container_highest.default.hex}};
}

QTabBar::tab:selected {
  background-color: {{colors.secondary_container.default.hex}};
  color: {{colors.on_secondary_container.default.hex}};
  font-weight: 600;
}

QScrollArea,
QScrollArea > QWidget > QWidget {
  background: transparent;
  border: none;
}

QPushButton {
  background-color: {{colors.surface_container_high.default.hex}};
  color: {{colors.on_surface.default.hex}};
  border: none;
  border-radius: 12px;
  padding: 12px 16px;
  margin: 2px 0;
}

QPushButton:hover {
  background-color: {{colors.surface_container_highest.default.hex}};
}

QPushButton:focus {
  outline: none;
}

QPushButton:pressed {
  background-color: {{colors.primary_container.default.hex}};
  color: {{colors.on_primary_container.default.hex}};
}

QCheckBox {
  color: {{colors.on_surface_variant.default.hex}};
  spacing: 8px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 2px solid {{colors.outline.default.hex}};
  border-radius: 5px;
  background: transparent;
}

QCheckBox::indicator:checked {
  border-color: {{colors.primary.default.hex}};
  background-color: {{colors.primary.default.hex}};
}

QScrollBar:vertical {
  background: transparent;
  width: 8px;
  margin: 2px;
}

QScrollBar::handle:vertical {
  background-color: {{colors.outline_variant.default.hex}};
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
  height: 0;
}
