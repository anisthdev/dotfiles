font-family = Google Sans Code NF
font-size = 14
# font-style = semibold
adjust-cell-width = 0%
adjust-cell-height = 12
adjust-underline-thickness = 1
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true
keybind = shift+enter=text:\x1b\r
theme = light:Gruvbox Light,dark:Gruvbox Dark

config-file = colors.conf

# GTK reads its own gtk.css once, at startup; this one is read again on every
# reload, so the tab bar follows matugen too
gtk-custom-css = ~/.config/gtk-4.0/gtk.css

